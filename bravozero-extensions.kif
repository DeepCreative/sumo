;; ========================================================================
;; bravozero-extensions.kif
;; ========================================================================
;;
;; Bravo Zero SUMO extensions for domain-specific concepts that cannot
;; be expressed by composing existing SUMO terms.
;;
;; Each term has passed the Discovery -> Classification -> Implementation
;; workflow documented in SUMO Capability Reference Part 6.
;;
;; Dependencies: Merge.kif, MilitaryProcesses.kif
;; Version: 0.1.0
;; Date: 2026-03-04

;; ========================================================================
;; RulesOfEngagement — Military engagement authorization profiles
;; ========================================================================
;;
;; Requesting system: JOSHUA (wargaming + simulation)
;; Discovery: PASSES — no existing ROE concept in SUMO
;; Classification: CLASS, subclass of NormativeAttribute
;;
;; Step 0 inference (acceptance test):
;;   Given (attribute ?AGENT weaponsHold) and (instance ?ATTACK Attack)
;;   and (agent ?ATTACK ?AGENT), prove there exists a prior ViolentContest
;;   where ?AGENT was the patient (self-defense justification).

(subclass RulesOfEngagement NormativeAttribute)
(documentation RulesOfEngagement EnglishLanguage
  "A &%NormativeAttribute specifying the conditions under which a
   &%MilitaryForce or &%CognitiveAgent is authorized to engage a
   target. Instances include &%weaponsFree, &%weaponsTight, and
   &%weaponsHold. These correspond to standard military rules of
   engagement profiles that constrain the use of force.")

(instance weaponsFree RulesOfEngagement)
(documentation weaponsFree EnglishLanguage
  "A &%RulesOfEngagement instance permitting engagement of any target
   not positively identified as friendly. This is the least
   restrictive engagement profile.")

(instance weaponsTight RulesOfEngagement)
(documentation weaponsTight EnglishLanguage
  "A &%RulesOfEngagement instance permitting engagement only of
   targets positively identified as hostile. The &%agent must confirm
   the target is an &%enemy before engaging.")

(instance weaponsHold RulesOfEngagement)
(documentation weaponsHold EnglishLanguage
  "A &%RulesOfEngagement instance prohibiting engagement except in
   immediate self-defense. This is the most restrictive engagement
   profile.")

;; An agent has at most one ROE profile at any given time.

(=>
  (and
    (instance ?ROE1 RulesOfEngagement)
    (instance ?ROE2 RulesOfEngagement)
    (holdsDuring ?TIME (attribute ?AGENT ?ROE1))
    (holdsDuring ?TIME (attribute ?AGENT ?ROE2)))
  (equal ?ROE1 ?ROE2))

;; weaponsTight: engagement authorized only against confirmed enemies.
;; Follows the confersRight pattern established in MilitaryProcesses.kif
;; for ArmedReconnaissance (line 89) and TerminalAttackControl (line 482).

(=>
  (and
    (attribute ?AGENT weaponsTight)
    (instance ?AGENT CognitiveAgent)
    (enemy ?AGENT ?TARGET))
  (confersRight
    (exists (?ATTACK)
      (and
        (instance ?ATTACK Attack)
        (agent ?ATTACK ?AGENT)
        (patient ?ATTACK ?TARGET)))
    weaponsTight
    ?AGENT))

;; weaponsHold: engagement requires self-defense justification.
;; If an agent under weaponsHold performs an attack, there must exist
;; a prior hostile act against that agent by the target.

(=>
  (and
    (attribute ?AGENT weaponsHold)
    (instance ?ATTACK Attack)
    (agent ?ATTACK ?AGENT)
    (patient ?ATTACK ?TARGET))
  (exists (?THREAT)
    (and
      (instance ?THREAT ViolentContest)
      (agent ?THREAT ?TARGET)
      (patient ?THREAT ?AGENT)
      (earlier (WhenFn ?THREAT) (WhenFn ?ATTACK)))))

;; ========================================================================
;; MeshIdentity — Delegated principal visibility across service hops
;; ========================================================================
;;
;; Requesting system: PERSONA (mesh identity / IUCT)
;; Discovery: PASSES — no existing multi-hop delegated-identity concept
;;            in SUMO. Closest existing terms (agent, authors, uses) model
;;            direct agency, not per-hop delegated propagation.
;; Classification: new BinaryPredicates plus a TernaryPredicate, plus
;;                 two rules (base + inductive) defining principal
;;                 visibility as the closure of consented hops.
;;
;; Step 0 inference (acceptance test):
;;   Given a chain of IUCT hops A -> B -> C originating at A for request
;;   Req with original principal U, and principalAllowlisted at every
;;   hop, prove that U is visible to C.
;;   Negative control: if any one principalAllowlisted entry in the
;;   chain is removed, U must NOT be provably visible to C.
;;
;; Why this matters: distinguishes topological reachability (a network
;; path exists) from delegated identity (per-hop mutual consent). The
;; common wrong intuition ("the JWT is forwarded, so the caller knows
;; the user") collapses a conjunction of per-hop checks into a single
;; transport property. The formalism makes every allowlist entry
;; load-bearing: drop any one and the conclusion fails to prove.

(subclass BzService Agent)
(documentation BzService EnglishLanguage
  "A computational &%Agent in the Bravo Zero service mesh that can
   participate in delegated-identity chains via IUCT (Inter-Unit Call
   Token) minting and verification.")

(subclass BzUser CognitiveAgent)
(documentation BzUser EnglishLanguage
  "A &%CognitiveAgent who is the original principal of a request that
   passes through one or more &%BzService hops in the mesh.")

(instance originatesRequest BinaryPredicate)
(domain originatesRequest 1 BzService)
(domain originatesRequest 2 Process)
(documentation originatesRequest EnglishLanguage
  "(originatesRequest ?A ?REQ) means &%BzService ?A is the entry point
   of request ?REQ into the mesh. The originating service is the one
   that first interacts with the user and initiates the IUCT chain.")

(instance iuctChainHop BinaryPredicate)
(domain iuctChainHop 1 BzService)
(domain iuctChainHop 2 BzService)
(documentation iuctChainHop EnglishLanguage
  "(iuctChainHop ?A ?B) means &%BzService ?A has made a direct,
   IUCT-authenticated call to &%BzService ?B. This is a per-call
   assertion; it does not imply transitivity on its own.")

(instance principalAllowlisted BinaryPredicate)
(domain principalAllowlisted 1 BzService)
(domain principalAllowlisted 2 BzService)
(documentation principalAllowlisted EnglishLanguage
  "(principalAllowlisted ?A ?B) means &%BzService ?A is configured
   to accept IUCT tokens minted for &%BzService ?B as the next hop.
   This is a per-hop authorization check, separate from and stricter
   than network reachability.")

(instance originalPrincipal BinaryPredicate)
(domain originalPrincipal 1 Process)
(domain originalPrincipal 2 BzUser)
(documentation originalPrincipal EnglishLanguage
  "(originalPrincipal ?REQ ?U) means &%BzUser ?U is the user on whose
   behalf request ?REQ was initiated.")

(instance visiblePrincipal TernaryPredicate)
(domain visiblePrincipal 1 BzService)
(domain visiblePrincipal 2 Process)
(domain visiblePrincipal 3 BzUser)
(documentation visiblePrincipal EnglishLanguage
  "(visiblePrincipal ?C ?REQ ?U) means &%BzService ?C can legitimately
   observe that &%BzUser ?U is the original principal of request ?REQ.
   This holds only when every hop between the origin of ?REQ and ?C is
   both an &%iuctChainHop and is &%principalAllowlisted.")

;; Base case.
;; The service that originated the request makes one allowlisted hop to
;; the next service; that next service sees the original principal.

(=>
  (and
    (originatesRequest ?A ?REQ)
    (originalPrincipal ?REQ ?U)
    (iuctChainHop ?A ?B)
    (principalAllowlisted ?A ?B))
  (visiblePrincipal ?B ?REQ ?U))

;; Inductive step.
;; Principal visibility propagates one more hop if and only if BOTH
;; the hop and the allowlist entry exist for that hop. Drop either
;; conjunct and the chain breaks at this link.

(=>
  (and
    (visiblePrincipal ?B ?REQ ?U)
    (iuctChainHop ?B ?C)
    (principalAllowlisted ?B ?C))
  (visiblePrincipal ?C ?REQ ?U))

;; ========================================================================
;; RbacScope — Role-bounded permission with explicit organizational scope
;; ========================================================================
;;
;; Requesting system: PERSONA (RBAC)
;; Discovery: PASSES — SUMO has the Organization class but no axiomatized
;;            role-and-scope model. Closest existing terms (memberFn,
;;            position, occupiesPosition) cover individual employment
;;            facts, not granted-permission derivations.
;; Classification: two new attribute classes (BzRole, BzPermission), four
;;                 new BinaryPredicates / TernaryPredicates, plus two
;;                 rules: a reflexive-scope axiom and a permission-
;;                 derivation rule.
;;
;; Step 0 inference (acceptance test):
;;   Given holdsRole(P, R, S) and roleGrants(R, Perm) and an Organization
;;   T included in S's scope, prove permitted(P, Perm, T).
;;   Negative control: if T is an Organization not asserted to be inside
;;   S's scope (e.g. a subsidiary of S), permitted(P, Perm, T) must NOT
;;   be provable.
;;
;; Why this matters: PERSONA's role assignments carry an explicit scope
;; (the org at which the role is held). The common LLM intuition is to
;; treat "role at parent org" as authority over child orgs. The formalism
;; refuses that step. Subsidiary access requires an explicit scopeIncludes
;; assertion, not an inference from organizational hierarchy. This forces
;; product/security to make scope-broadening grants visible and auditable.

(subclass BzRole NormativeAttribute)
(documentation BzRole EnglishLanguage
  "A role assignable to a &%CognitiveAgent within the scope of an
   &%Organization. Each &%BzRole grants a set of &%BzPermission
   instances via the &%roleGrants relation.")

(subclass BzPermission NormativeAttribute)
(documentation BzPermission EnglishLanguage
  "A permission to perform a specific class of action. Granted to a
   &%CognitiveAgent indirectly via a &%BzRole and bounded by the
   role's scope.")

(instance holdsRole TernaryPredicate)
(domain holdsRole 1 CognitiveAgent)
(domain holdsRole 2 BzRole)
(domain holdsRole 3 Organization)
(documentation holdsRole EnglishLanguage
  "(holdsRole ?P ?R ?S) means &%CognitiveAgent ?P holds &%BzRole ?R
   within the scope of &%Organization ?S. The third argument is the
   scope at which the role is held; it does not by itself imply
   authority over child or related organizations.")

(instance roleGrants BinaryPredicate)
(domain roleGrants 1 BzRole)
(domain roleGrants 2 BzPermission)
(documentation roleGrants EnglishLanguage
  "(roleGrants ?R ?PERM) means holders of &%BzRole ?R are granted
   &%BzPermission ?PERM, subject to the scope constraints of the
   role assignment.")

(instance scopeIncludes BinaryPredicate)
(domain scopeIncludes 1 Organization)
(domain scopeIncludes 2 Organization)
(documentation scopeIncludes EnglishLanguage
  "(scopeIncludes ?S ?T) means &%Organization ?T is within the
   permission scope of &%Organization ?S. This relation is reflexive
   on Organizations but is NOT inferred from organizational hierarchy
   (e.g. subOrganization). Cross-org and parent->child scope must be
   asserted explicitly.")

(instance permitted TernaryPredicate)
(domain permitted 1 CognitiveAgent)
(domain permitted 2 BzPermission)
(domain permitted 3 Organization)
(documentation permitted EnglishLanguage
  "(permitted ?P ?PERM ?T) means &%CognitiveAgent ?P is authorized
   to exercise &%BzPermission ?PERM on behalf of &%Organization ?T.
   Derived from a &%holdsRole assertion whose role grants ?PERM and
   whose scope includes ?T.")

;; Reflexive scope.
;; Every Organization is in its own permission scope by default.
;; Cross-organization scope (e.g. parent -> subsidiary) is NOT inferred;
;; it must be asserted explicitly via scopeIncludes.

(=>
  (instance ?O Organization)
  (scopeIncludes ?O ?O))

;; Permission derivation.
;; Holding a role within scope S grants the role's permissions for
;; any target T that is in S's scope.

(=>
  (and
    (holdsRole ?P ?R ?S)
    (roleGrants ?R ?PERM)
    (scopeIncludes ?S ?T))
  (permitted ?P ?PERM ?T))

;; ========================================================================
;; AuditTenantIsolation - Cross-tenant audit visibility scoped by support case
;; ========================================================================
;;
;; Requesting system: Athena (audit query layer over events emitted by
;;                    bz-observability)
;; Discovery: PASSES - SUMO has the Organization class and a primitive
;;            notion of time, but no axiomatized model of multi-tenant
;;            data visibility with a scoped exception. Closest existing
;;            terms (subOrganization, contains, holdsDuring) cover
;;            organizational structure and temporal facts but not
;;            data-access boundaries with explicit per-case grants.
;; Classification: two new entity classes (AuditEvent, SupportCase) plus
;;                 six new BinaryPredicates and two derivation rules.
;;
;; Step 0 inference (acceptance test):
;;   Given userTenant(U, T_user), auditEventTenant(E, T_event), and
;;   either (T_user equals T_event) OR (a SupportCase C exists where U
;;   is staff, C includesTenant T_event, and the event is within C's
;;   active window), prove visibleAudit(U, E).
;;   Negative control: if U's tenant differs from E's tenant AND any
;;   one of the support-case conjuncts is missing (in particular,
;;   withinCaseWindow), visibleAudit(U, E) must NOT be provable.
;;
;; Why this matters: cross-tenant data leakage is the single most common
;; question regulated buyers ask during procurement. The naive intuition
;; "support engineers can see anything for support purposes" is exactly
;; the failure mode. The formalism forces every support-case access to
;; be scoped to a specific case and timestamped within that case's
;; window. Drop withinCaseWindow and the exception does not fire.

(subclass AuditEvent ContentBearingObject)
(documentation AuditEvent EnglishLanguage
  "An immutable structured record describing a security-relevant
   action taken in a Bravo Zero service. Emitted via &%bz-observability
   and queryable via &%bz-client.audit (Athena).")

(subclass SupportCase Process)
(documentation SupportCase EnglishLanguage
  "A scoped grant of cross-tenant audit-query authority to a support
   engineer for a specific time window and a specific set of
   &%Organization tenants. Required to legitimize any cross-tenant
   audit visibility outside the user's home tenant.")

(instance userTenant BinaryPredicate)
(domain userTenant 1 CognitiveAgent)
(domain userTenant 2 Organization)
(documentation userTenant EnglishLanguage
  "(userTenant ?U ?T) means &%CognitiveAgent ?U is a member of
   &%Organization ?T as their home tenant. A user has exactly one
   home tenant; access to other tenants requires explicit grants.")

(instance auditEventTenant BinaryPredicate)
(domain auditEventTenant 1 AuditEvent)
(domain auditEventTenant 2 Organization)
(documentation auditEventTenant EnglishLanguage
  "(auditEventTenant ?E ?T) means &%AuditEvent ?E was emitted by a
   service operating on behalf of &%Organization ?T. Establishes the
   tenant of record for the event.")

(instance staffOf BinaryPredicate)
(domain staffOf 1 CognitiveAgent)
(domain staffOf 2 SupportCase)
(documentation staffOf EnglishLanguage
  "(staffOf ?U ?C) means &%CognitiveAgent ?U is assigned as support
   staff on &%SupportCase ?C. Required for cross-tenant audit
   visibility under the support-case exception.")

(instance caseIncludesTenant BinaryPredicate)
(domain caseIncludesTenant 1 SupportCase)
(domain caseIncludesTenant 2 Organization)
(documentation caseIncludesTenant EnglishLanguage
  "(caseIncludesTenant ?C ?T) means &%SupportCase ?C is authorized
   to access data scoped to &%Organization ?T. A case may include
   multiple tenants if the issue spans them.")

(instance withinCaseWindow BinaryPredicate)
(domain withinCaseWindow 1 SupportCase)
(domain withinCaseWindow 2 AuditEvent)
(documentation withinCaseWindow EnglishLanguage
  "(withinCaseWindow ?C ?E) means the timestamp of &%AuditEvent ?E
   falls within the active window of &%SupportCase ?C. This is the
   load-bearing temporal constraint on the support-case exception:
   without it, support staff would inherit unbounded historical
   visibility into included tenants.")

(instance visibleAudit BinaryPredicate)
(domain visibleAudit 1 CognitiveAgent)
(domain visibleAudit 2 AuditEvent)
(documentation visibleAudit EnglishLanguage
  "(visibleAudit ?U ?E) means &%CognitiveAgent ?U is authorized to
   query &%AuditEvent ?E. Derivable only via the same-tenant rule
   or the time-windowed support-case exception.")

;; Same-tenant rule.
;; A user in tenant T may query audit events emitted by T.

(=>
  (and
    (userTenant ?U ?T)
    (auditEventTenant ?E ?T))
  (visibleAudit ?U ?E))

;; Support-case exception.
;; A support engineer staffed on a case covering tenant T may query
;; an event from T, BUT only if the event is within the case's
;; active window. The withinCaseWindow conjunct is the difference
;; between scoped support access and unbounded cross-tenant access.

(=>
  (and
    (staffOf ?U ?C)
    (caseIncludesTenant ?C ?T)
    (auditEventTenant ?E ?T)
    (withinCaseWindow ?C ?E))
  (visibleAudit ?U ?E))
